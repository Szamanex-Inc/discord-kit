# Bot token from https://discord.com/developers/applications (Bot tab -> Reset Token)
DISCORD_TOKEN=
# Server ID (enable Developer Mode in Discord, right-click the server -> Copy Server ID)
GUILD_ID=
# Preset folder (config.yaml + content), relative to the repo root or absolute
PRESET_DIR=presets/example
# Optional: where the bot keeps its SQLite database (default: data/ in the repo)
# DATA_DIR=data
# Optional: reload config.yaml automatically when it changes (default true)
# PRESET_WATCH=false
# Optional: preset commit shown by /deploy status (otherwise <preset>/.revision or git)
# PRESET_REVISION=
# Optional kill switch: force-disable features, comma separated
# DISABLED_FEATURES=role_picker
# Optional: GitHub App for the github feature (see docs/github-app.md)
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY_FILE=/path/to/private-key.pem
# GITHUB_PRIVATE_KEY=
